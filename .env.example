# ============================================================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ============================================================================
# Database connection (managed by Render.com)
DATABASE_URL=postgresql://user:password@host/db

# CORS configuration
CORS_ORIGIN=https://rekoma-318.vercel.app

# JWT/Session secrets (replace with strong random values)
JWT_SECRET=your-super-secret-key-change-me
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-me
ADMIN_SESSION_SECRET=your-admin-session-secret-change-me

# Email/SMTP configuration (for sending emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@rekoma.org

# Stripe configuration (payment processing)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Muvola/Airtel payment configuration (optional)
MVOLA_API_KEY=your-mvola-api-key
MVOLA_API_URL=https://api.airtel.mg

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env.local)
# ============================================================================
# API endpoint for backend communication
NEXT_PUBLIC_API_URL=https://rekoma318.onrender.com

# Public website URL (for SEO, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://rekoma-318.vercel.app

# Admin credentials (for testing - change in production)
ADMIN_EMAIL=andrianisaina23@gmail.com
ADMIN_PASSWORD=2311saina!

# Admin session secret (must match backend)
ADMIN_SESSION_SECRET=your-admin-session-secret-change-me

# Default admin role
ADMIN_ROLE=super_admin

# Stripe publishable key (for frontend payment processing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ============================================================================
# DEPLOYMENT PLATFORMS
# ============================================================================
# RENDER.COM (Backend)
# - Database: PostgreSQL (Frankfurt region)
# - API Server URL: https://rekoma318.onrender.com
# - Recommended: Add all backend env vars above to Render dashboard
#
# VERCEL (Frontend)
# - App URL: https://rekoma-318.vercel.app
# - Branch: main
# - Recommended: Add all frontend env vars above to Vercel dashboard
#
# ============================================================================
