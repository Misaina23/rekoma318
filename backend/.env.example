# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/rekoma?sslmode=require

# JWT secret (must be set in production)
JWT_SECRET=replace_with_strong_secret

# CORS allowed origin (frontend)
CORS_ORIGIN=https://rekoma-318.vercel.app

# Frontend base URL (reset-password links, emails, etc.)
FRONTEND_URL=https://rekoma-318.vercel.app

# Email (SMTP Gmail)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="REKOMA"

# MVola (pre-production)
MVOLA_TOKEN_URL=https://pre-api.mvola.mg/token/1
MVOLA_BASE_URL=https://pre-api.mvola.mg
MVOLA_API_KEY=your_mvola_consumer_key
MVOLA_API_SECRET=your_mvola_consumer_secret
MVOLA_MERCHANT_ID=your_merchant_id
MVOLA_MERCHANT_PIN=your_merchant_pin
MVOLA_DEFAULT_RECEIVER=+261345332429

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Node environment
NODE_ENV=production

# App
PORT=4000
