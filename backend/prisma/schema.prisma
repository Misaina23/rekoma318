generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailVerified   Boolean          @default(false)
  password        String
  role            String           @default("viewer")
  name            String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  active          Boolean          @default(true)
  lastLoginAt     DateTime?        @db.Timestamptz(6)
  memberId        String?          @unique
  permissions     Json?
  twoFactorEnabled Boolean        @default(false)
  refreshTokens   RefreshToken[]
  twoFactorTokens TwoFactorToken[]
  passwordResets  PasswordReset[]
  member          Member?          @relation(fields: [memberId], references: [id])
  userPermissions UserPermission[]
  roleRef         Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  roleId          String?
}

model Producteur {
  id          String   @id @default(cuid())
  nom         String
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Message {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  body      String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  read      Boolean   @default(false)
  archived  Boolean   @default(false)
  deletedAt DateTime? @db.Timestamptz(6)
  replies   Reply[]

  @@index([email])
}

model Reply {
  id        String   @id @default(cuid())
  messageId String
  from      String
  body      String
  at        DateTime @default(now()) @db.Timestamptz(6)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model News {
  id        String    @id @default(cuid())
  date      DateTime  @default(now())
  titleFr   String
  excerptFr String
  tagFr     String
  image     String?
  published Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)
}

model Document {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileUrl     String?
  imageUrl    String?
  category    String?
  date        DateTime  @default(now())
  published   Boolean   @default(true)
  deletedAt   DateTime? @db.Timestamptz(6)
}

model GalleryEvent {
  id        String         @id @default(cuid())
  title     String
  date      DateTime       @default(now())
  deletedAt DateTime?      @db.Timestamptz(6)
  photos    GalleryPhoto[]
}

model GalleryPhoto {
  id      String       @id @default(cuid())
  url     String
  eventId String
  event   GalleryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Activity {
  id           String    @id @default(cuid())
  title        String
  responsible  String?
  date         DateTime  @default(now())
  budget       Int       @default(0)
  objectives   String?
  participants Int       @default(0)
  results      String?
  photos       String[]
  documents    String[]
  status       String    @default("planned")
  deletedAt    DateTime? @db.Timestamptz(6)
}

model Formation {
  id            String        @id @default(cuid())
  title         String
  description   String?
  session       String?
  startDate     DateTime?
  endDate       DateTime?
  location      String?
  trainer       String?
  date          DateTime      @default(now())
  participants  Int           @default(0)
  attendees     Int           @default(0)
  evaluation    Float         @default(0)
  certificate   Boolean       @default(false)
  status        String        @default("planned")
  deletedAt     DateTime?     @db.Timestamptz(6)
  beneficiaries Beneficiary[]
}

model Member {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  sex          String    @default("M")
  role         String?
  designation  String?
  description  String?
  address      String?
  phone        String?
  email        String?
  status       String    @default("active")
  displayOrder Int       @default(999)
  joinedAt     DateTime  @default(now())
  photo        String?
  deletedAt    DateTime? @db.Timestamptz(6)
  user         User?
}

model Donation {
  id          String    @id @default(cuid())
  donor       String
  email       String
  phone       String?
  amount      Int
  method      String
  status      String    @default("pending")
  providerRef String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([createdAt])
  @@index([status])
}

model Beneficiary {
  id            String     @id @default(cuid())
  firstName     String
  lastName      String
  cin           String?    @unique
  birthDate     DateTime?
  sex           String?    @default("M")
  phone         String?
  address       String?
  commune       String?
  name          String
  category      String
  formationId   String?
  contact       String?
  status        String?    @default("active")
  attendance    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  deletedAt     DateTime?  @db.Timestamptz(6)
  formation     Formation? @relation(fields: [formationId], references: [id])

  @@index([category])
  @@index([formationId])
  @@index([cin])
}

model TwoFactorToken {
  id        String   @id @default(cuid())
  userId    String
  email     String
  sessionId String   @unique
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([email])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)

  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  email     String
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  isSystem    Boolean  @default(false)
  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  category    String
  description String?
  roles       RolePermission[]
  userOverrides UserPermission[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([key])
  @@index([category])
}

model RolePermission {
  id           String    @id @default(cuid())
  roleId       String
  permissionId String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserPermission {
  id           String    @id @default(cuid())
  userId       String
  permissionId String
  mode         String   @default("add") // add | remove
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, mode])
  @@index([userId])
  @@index([permissionId])
}
