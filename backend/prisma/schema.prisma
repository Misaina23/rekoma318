generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailVerified   Boolean          @default(false)
  password        String
  role            String           @default("viewer")
  name            String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  active          Boolean          @default(true)
  lastLoginAt     DateTime?        @db.Timestamptz(6)
  memberId        String?          @unique
  permissions     Json?
  twoFactorEnabled Boolean        @default(false)
  refreshTokens   RefreshToken[]
  twoFactorTokens TwoFactorToken[]
  passwordResets  PasswordReset[]
  member          Member?          @relation(fields: [memberId], references: [id])
  userPermissions UserPermission[]
  roleRef         Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  roleId          String?
}

model Producteur {
  id          String   @id @default(cuid())
  nom         String
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Message {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  body      String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  read      Boolean   @default(false)
  archived  Boolean   @default(false)
  deletedAt DateTime? @db.Timestamptz(6)
  replies   Reply[]

  @@index([email])
}

model Reply {
  id        String   @id @default(cuid())
  messageId String
  from      String
  body      String
  at        DateTime @default(now()) @db.Timestamptz(6)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model News {
  id        String    @id @default(cuid())
  date      DateTime  @default(now())
  titleFr   String
  excerptFr String
  tagFr     String
  image     String?
  published Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)
}

model Document {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileUrl     String?
  imageUrl    String?
  category    String?
  date        DateTime  @default(now())
  published   Boolean   @default(true)
  deletedAt   DateTime? @db.Timestamptz(6)
}

model GalleryEvent {
  id        String         @id @default(cuid())
  title     String
  date      DateTime       @default(now())
  deletedAt DateTime?      @db.Timestamptz(6)
  photos    GalleryPhoto[]
}

model GalleryPhoto {
  id      String       @id @default(cuid())
  url     String
  eventId String
  event   GalleryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Activity {
  id                 String                @id @default(cuid())
  title              String
  responsible        String?
  responsibleStaffId String?               @map("responsible_staff_id")
  date               DateTime              @default(now())
  budget             Int                   @default(0)
  objectives         String?
  participants       Int                   @default(0)
  results            String?
  photos             String[]
  documents          String[]
  status             String                @default("planned")
  deletedAt          DateTime?             @db.Timestamptz(6)
  responsibleStaff   Staff?                @relation("ActivityResponsible", fields: [responsibleStaffId], references: [id], onDelete: SetNull)
  beneficiaryLinks   ActivityBeneficiary[]

  @@index([responsibleStaffId])
}

model Formation {
  id             String                @id @default(cuid())
  title          String
  description    String?
  session        String?
  startDate      DateTime?
  endDate        DateTime?
  location       String?
  trainer        String?
  trainerStaffId String?               @map("trainer_staff_id")
  date           DateTime              @default(now())
  capacity       Int                   @default(30)
  participants   Int                   @default(0)
  attendees      Int                   @default(0)
  evaluation     Float                 @default(0)
  certificate    Boolean               @default(false)
  status         String                @default("planned")
  deletedAt      DateTime?             @db.Timestamptz(6)
  trainerStaff   Staff?                @relation("FormationTrainer", fields: [trainerStaffId], references: [id], onDelete: SetNull)
  enrollments    FormationEnrollment[]

  @@index([trainerStaffId])
  @@index([status])
}

model Member {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  sex          String    @default("M")
  role         String?
  designation  String?
  description  String?
  address      String?
  phone        String?
  email        String?
  status       String    @default("active")
  displayOrder Int       @default(999)
  joinedAt     DateTime  @default(now())
  photo        String?
  deletedAt    DateTime? @db.Timestamptz(6)
  user         User?
  staff        Staff?
}

model Donation {
  id          String    @id @default(cuid())
  donor       String
  email       String
  phone       String?
  amount      Int
  method      String
  status      String    @default("pending")
  providerRef String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([createdAt])
  @@index([status])
}

model StoreProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  price       Int
  imageUrl    String?
  sizes       String[] @default([])
  active      Boolean  @default(true)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([published, active])
}

model StoreOrder {
  id             String   @id @default(cuid())
  customerName   String
  phone          String
  city           String
  deliveryType   String
  address        String?
  note           String?
  items           Json
  total           Int
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
}

model Beneficiary {
  id                     String                @id @default(cuid())
  firstName              String
  lastName               String
  cin                    String?               @unique
  birthDate              DateTime?
  sex                    String?               @default("M")
  phone                  String?
  email                  String?
  address                String?
  commune                String?
  fokontany              String?
  householdSize          Int?                  @map("household_size")
  name                   String
  category               String
  contact                String?
  status                 String?               @default("active")
  notes                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now()) @updatedAt
  deletedAt              DateTime?             @db.Timestamptz(6)
  formationEnrollments   FormationEnrollment[]
  activityParticipations ActivityBeneficiary[]

  @@index([category])
  @@index([commune])
  @@index([cin])
}

model FormationEnrollment {
  id                String      @id @default(cuid())
  formationId       String      @map("formation_id")
  beneficiaryId     String      @map("beneficiaire_id")
  attendanceStatus  String      @default("enrolled") @map("statut_presence")
  evaluationScore   Float?      @map("note_evaluation")
  certificateIssued Boolean     @default(false) @map("attestation_delivree")
  notes             String?
  enrolledAt        DateTime    @default(now()) @map("date_inscription") @db.Timestamptz(6)
  formation         Formation   @relation(fields: [formationId], references: [id], onDelete: Cascade)
  beneficiary       Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([formationId, beneficiaryId])
  @@index([formationId])
  @@index([beneficiaryId])
  @@map("formation_beneficiaire")
}

model ActivityBeneficiary {
  id             String      @id @default(cuid())
  activityId     String      @map("activite_id")
  beneficiaryId  String      @map("beneficiaire_id")
  role           String?     @default("participant")
  present        Boolean     @default(true)
  notes          String?
  participatedAt DateTime    @default(now()) @map("date_participation") @db.Timestamptz(6)
  activity       Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  beneficiary    Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([activityId, beneficiaryId])
  @@index([activityId])
  @@index([beneficiaryId])
  @@map("activite_beneficiaire")
}

model Staff {
  id                  String               @id @default(cuid())
  matricule           String               @unique
  firstName           String               @map("prenom")
  lastName            String               @map("nom")
  cin                 String?              @unique
  sex                 String               @default("M") @map("sexe")
  birthDate           DateTime?            @map("date_naissance")
  phone               String?              @map("telephone")
  email               String?
  address             String?              @map("adresse")
  position            String               @map("poste")
  department          String               @default("Coordination PDIMA") @map("departement")
  hireDate            DateTime             @default(now()) @map("date_embauche")
  status              String               @default("active") @map("statut")
  evaluationScore     Float?               @map("note_suivi")
  professionalNotes   String?              @map("suivi_professionnel")
  memberId            String?              @unique @map("member_id")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  member              Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  contracts           EmploymentContract[]
  formationsTrained   Formation[]          @relation("FormationTrainer")
  activitiesManaged   Activity[]           @relation("ActivityResponsible")

  @@index([department])
  @@index([status])
  @@map("personnel")
}

model EmploymentContract {
  id                 String    @id @default(cuid())
  staffId            String    @map("personnel_id")
  contractType       String    @default("CDD") @map("type_contrat")
  startDate          DateTime  @default(now()) @map("date_debut")
  endDate            DateTime? @map("date_fin")
  salary             Int       @default(0) @map("salaire_mensuel")
  assignmentLocation String?   @map("lieu_affectation")
  status             String    @default("active") @map("statut")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  staff              Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([status])
  @@map("contrat_personnel")
}

model SiteVisit {
  id          String   @id @default(cuid())
  day         String
  path        String   @default("/")
  visitorHash String?  @map("visitor_hash")
  isAdmin     Boolean  @default(false) @map("is_admin")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([day])
  @@index([path])
  @@index([isAdmin, day])
  @@map("site_visits")
}

model TwoFactorToken {
  id        String   @id @default(cuid())
  userId    String
  email     String
  sessionId String   @unique
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([email])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  verified  Boolean  @default(false)

  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  email     String
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  isSystem    Boolean  @default(false)
  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  category    String
  description String?
  roles       RolePermission[]
  userOverrides UserPermission[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([key])
  @@index([category])
}

model RolePermission {
  id           String    @id @default(cuid())
  roleId       String
  permissionId String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserPermission {
  id           String    @id @default(cuid())
  userId       String
  permissionId String
  mode         String   @default("add") // add | remove
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, mode])
  @@index([userId])
  @@index([permissionId])
}
